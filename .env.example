ANTHROPIC_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the sandbox app's webhook list (python backend/paypal.py prints it)
PAYPAL_WEBHOOK_ID=
# Four digits the shopper types on the PIN pad to pay
PAY_PIN=
# Secret in the family link (caregiver.html#key=...). Only the family approves held payments with it.
FAMILY_KEY=
# Name the shopper hears for whoever approves held payments
# TRUSTED_CONTACT=your family
# Phone number the shopper is offered while an order is held
# TRUSTED_CONTACT_PHONE=
# ntfy topic that pushes held orders and PIN lockouts to the family's phones; keep the name long and random
# FAMILY_NTFY_URL=https://ntfy.sh/
# Copy of the saved PayPal account id, printed by the server after Connect PayPal; survives a wiped disk
# PAYPAL_VAULT_ID=
# Where the frontend lives; PayPal sends the approver back here
# APP_URL=http://localhost:5174
# Defaults to sandbox
# PAYPAL_BASE=https://api-m.sandbox.paypal.com
